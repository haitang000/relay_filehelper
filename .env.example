PORT=3001
HOST=127.0.0.1
DATA_DIR=./data
# Public URL users actually open. No trailing slash. Required in production.
# An https origin also enables HSTS. Leave this unset for local Vite development.
PUBLIC_ORIGIN=https://files.example.com
# false closes registration completely, including the first account.
# Create that account with: printf '%s' 'password' | npm run admin -- create-user alice
REGISTRATION_ENABLED=false
COOKIE_SECURE=true
TRUST_PROXY=1
MAX_FILE_BYTES=1073741824
MAX_BATCH_FILES=20
MAX_CONCURRENT_UPLOADS=2
MAX_CONCURRENT_DOWNLOADS=2
ROOM_QUOTA_BYTES=10737418240
TOTAL_QUOTA_BYTES=53687091200
SESSION_DAYS=30
